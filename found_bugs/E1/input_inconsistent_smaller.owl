Prefix(:=<http://www.example.org/reasonerTester#>)

Ontology (

Declaration(NamedIndividual(:a))

Declaration(Class(:B))
Declaration(Class(:A))


Declaration(DataProperty(:dr))


EquivalentClasses(
    DataHasValue(:dr "s1"@fr) 
    :A
    :B 
)

DisjointClasses( 
    :A
    DataHasValue(:dr "s1"@en) 
    # problem: ELK unifies "s1" and "s1"@en --> infers that :B is empty
)

ClassAssertion(:B :a)

)
